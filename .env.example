# Local gateway defaults; config/gateway.yaml supplies the same defaults.
NODE_ENV=development
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
# Optional alternate gateway YAML file; uncomment to override the bundled path.
# GATEWAY_CONFIG=config/gateway.yaml
ROUTER_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUEST_BYTES=65536
REQUEST_TIMEOUT_MS=180000
LOG_LEVEL=info
RUST_LOG=info
BENCHMARK_ENABLED=true
BENCH_RESULTS_DIR=bench/results
PROJECT_ROOT=..

# Local Rust router (Compose overrides these service addresses in-container).
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8081
SERVER_CONFIG=config/server.yaml
MODELS_CONFIG=config/models.yaml
ROUTING_CONFIG=config/routing.yaml
OLLAMA_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_MS=120000
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_TEMPERATURE=0.2

# Frontend Vite
VITE_API_BASE=/api
VITE_GATEWAY_URL=http://127.0.0.1:3000
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
VITE_PREVIEW_HOST=0.0.0.0
VITE_PREVIEW_PORT=4173

# Benchmark runner; paths are relative to the repository root.
BENCH_GATEWAY_URL=http://localhost:3000
BENCH_PROMPTS=bench/prompts.json
BENCH_RESULTS_DIR=bench/results
BENCH_TIMEOUT_MS=180000
BENCH_LIMIT=0
BENCH_RESUME=false
BENCH_BACKEND=auto
BENCH_HARDWARE=
BENCH_GPU=

# Docker Compose host integration (separate from local OLLAMA_URL).
COMPOSE_OLLAMA_URL=http://host.docker.internal:11434
COMPOSE_CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Change this before starting the Grafana observability overlay.
GRAFANA_ADMIN_PASSWORD=change-this-local-password

# Optional mock delay/failure injection (development/CI only).
MOCK_OLLAMA_HOST=0.0.0.0
MOCK_OLLAMA_PORT=11434
MOCK_OLLAMA_MODELS=
MOCK_OLLAMA_DELAY_MS=0
MOCK_OLLAMA_DELAY_MAP=
MOCK_OLLAMA_TOKEN_DELAY_MS=15
MOCK_OLLAMA_LOAD_DELAY_MS=250
MOCK_OLLAMA_FAIL_MODE=500
MOCK_OLLAMA_FAIL_MODELS=
MOCK_OLLAMA_LOADED_MODEL=
MOCK_ROUTER_TOKEN_DELAY_MS=18
MOCK_ROUTER_FIRST_TOKEN_MS=350
MOCK_ROUTER_FAIL_MODELS=
MOCK_ROUTER_LOADED_MODEL=
