{
  "name": "@llm-router/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:types": "openapi-typescript ../contracts/openapi.yaml -o src/types/api.generated.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "undici": "6.29.1",
    "yaml": "2.9.1",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
