{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-router.local/contracts/benchmark-result.schema.json",
  "type": "object",
  "required": ["id", "created_at", "hardware", "prompt_count", "runs", "per_request"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "hardware": { "type": "string" },
    "prompt_count": { "type": "integer", "minimum": 0 },
    "methodology": { "type": "string" },
    "verdict": { "type": "string" },
    "runs": {
      "type": "object",
      "required": ["A", "B", "C"],
      "properties": {
        "A": { "$ref": "#/$defs/metric" },
        "B": { "$ref": "#/$defs/metric" },
        "C": { "$ref": "#/$defs/metric" }
      },
      "additionalProperties": false
    },
    "per_request": {
      "type": "array",
      "items": { "$ref": "#/$defs/requestMeasurement" }
    },
    "confusion_matrix": { "type": "object" },
    "kpis": { "type": "object" }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["mean_ms", "p50_ms", "p95_ms", "ttft_mean_ms", "tokens_per_sec", "swaps", "cache_hit_rate", "total_wall_ms"],
      "properties": {
        "mean_ms": { "type": "number", "minimum": 0 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "ttft_mean_ms": { "type": "number", "minimum": 0 },
        "tokens_per_sec": { "type": "number", "minimum": 0 },
        "swaps": { "type": "integer", "minimum": 0 },
        "peak_vram_bytes": { "type": "integer", "minimum": 0 },
        "cache_hit_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "total_wall_ms": { "type": "number", "minimum": 0 }
      }
    },
    "requestMeasurement": {
      "type": "object",
      "required": ["run", "prompt_id", "expected_tier", "routed_tier", "model", "latency_ms", "ttft_ms", "tokens_per_sec", "completion_tokens", "load_ms", "cache", "swap_expected"],
      "properties": {
        "run": { "type": "string", "enum": ["A", "B", "C"] },
        "prompt_id": { "type": "string", "minLength": 1 },
        "expected_tier": { "type": "string", "enum": ["light", "code", "heavy"] },
        "routed_tier": { "type": "string", "enum": ["light", "code", "heavy"] },
        "model": { "type": "string", "minLength": 1 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "ttft_ms": { "type": "number", "minimum": 0 },
        "tokens_per_sec": { "type": "number", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "load_ms": { "type": "number", "minimum": 0 },
        "cache": { "type": "string", "enum": ["hit", "miss", "bypass"] },
        "swap_expected": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
